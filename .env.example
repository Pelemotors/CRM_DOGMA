# ===== T.A Motors CRM — local secrets (never commit) =====
# Copy to .env and fill in values shared with ta-motors / Supabase.

PORT=3001
HOST=0.0.0.0

# Supabase (backup + publish mirror for website inventory)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Website cache bust after inventory sync
VERCEL_REVALIDATE_URL=https://t-a-motors.co.il/api/revalidate
REVALIDATE_SECRET=

# Inbound webhook from ta-motors lead forms (must match ta-motors CRM_INBOUND_API_KEY)
CRM_INBOUND_API_KEY=

# Wonder AI gateway (optional)
AI_API_KEY=change-me-to-a-long-random-secret
# AI_RATE_LIMIT_PER_MIN=60
# AI_WRITE_ENABLED=1
